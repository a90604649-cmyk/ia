GROQ_API_KEY=tu_clave_de_groq
GROQ_API_KEYS=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_REASONING_EFFORT=default
GROQ_REASONING_FORMAT=hidden
GROQ_MAX_OUTPUT_TOKENS=16384
GROQ_TIMEOUT_MS=300000
GROQ_RETRY_DELAY_MS=5000
GROQ_CHAT_MAX_OUTPUT_TOKENS=700

# Proveedor de respaldo para programación cuando Groq llega a su límite o trunca la salida.
OPENROUTER_API_KEY=tu_clave_de_openrouter
OPENROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_MAX_OUTPUT_TOKENS=6000
OPENROUTER_SWITCH_REMAINING_TOKENS=700
OPENROUTER_HANDOFF=true
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Roblox AI Bridge

PORT=3000
PROJECT_CONTEXT_PORT=3001
PROJECT_CONTEXT_HOST=0.0.0.0
